rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Livros públicos da biblioteca padrão (somente leitura)
    match /default_books/{bookId} {
      allow read: if true;
      allow write: if false;
    }

    // Coleções de usuários (livros personalizados, progresso e destaques)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /books/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /progress/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /highlights/{highlightId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
